# Machine-specific runtime paths for tools/server.py. This file is a template: nothing in it is
# a real path, and nothing in it has to be set.
#
# Most paths resolve themselves on a `--recursive` clone that has run `uv sync`, so this file
# only exists for the two that have no default. Only the lines below that are already uncommented
# need values; uncomment another only to override its default.
#
# Copy it out of Git's way and load it:
#   cp examples/site.example.env site.local.env   # site.local.env is ignored
#   set -a; . site.local.env; set +a
# `./r2s-server site` prints what each path currently resolves to; null means neither set nor
# defaulted. Putting the same exports in your shell profile works too.

# The lab's own data. No default can invent these, and commands that need them say so by name.
export R2S_MEASURED_CASE=/absolute/path/to/measured_case
export R2S_REFERENCE_TEMPLATE=/absolute/path/to/reference_template

# Already defaulted -- uncomment only to point somewhere else.
# export R2S_MAIN_PYTHON=/absolute/path/to/main_python
# export R2S_CYCLES_PYTHON=/absolute/path/to/cycles_python
# export R2S_FFMPEG=/absolute/path/to/ffmpeg
# export R2S_NEWTON_PROJECT=/absolute/path/to/newton_project
# export R2S_RUNS_ROOT=/absolute/path/to/runs_root
