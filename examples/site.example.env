# Machine-specific runtime paths for tools/server.py. Nothing here is a real path.
#
# Fill in your own and load them before running ./r2s-server:
#   set -a; . examples/site.example.env; set +a
# To keep them out of Git, copy this file to site.local.env (ignored) and load that.
# Putting the same exports in your shell profile works too; `./r2s-server site`
# prints whatever the environment currently resolves to.
export R2S_MAIN_PYTHON=/absolute/path/to/main_python
export R2S_CYCLES_PYTHON=/absolute/path/to/cycles_python
export R2S_FFMPEG=/absolute/path/to/ffmpeg
export R2S_NEWTON_PROJECT=/absolute/path/to/newton_project
export R2S_MEASURED_CASE=/absolute/path/to/measured_case
export R2S_REFERENCE_TEMPLATE=/absolute/path/to/reference_template
export R2S_RUNS_ROOT=/absolute/path/to/runs_root
